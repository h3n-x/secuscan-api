POSTGRES_USER=user
POSTGRES_PASSWORD=password
POSTGRES_DB=secuscan
# DATABASE_URL ya no se declara acá — docker-compose.yml la computa a partir de las 3
# variables de arriba (misma fuente de verdad). Si corrés la app FUERA de docker-compose,
# ahí sí necesitás setear DATABASE_URL vos mismo (ej. postgresql+asyncpg://user:password@localhost:5432/secuscan).
JWT_SECRET_KEY=
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
RATE_LIMIT_PER_HOUR=10
ALLOWED_PORT_RANGE_START=1
ALLOWED_PORT_RANGE_END=1024
PORT_SCAN_CONCURRENCY=50
PORT_SCAN_TIMEOUT_SECONDS=1.0
ENVIRONMENT=development

# Solo para desarrollo local: permite escanear IPs privadas/loopback/link-local (127.0.0.1,
# 10.x, 172.16-31.x, 192.168.x, 169.254.x). NUNCA activar en un ambiente expuesto: abre la
# puerta a SSRF hacia infraestructura interna (incluida la IP de metadata de la nube).
ALLOW_PRIVATE_TARGETS=false
